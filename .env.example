# career-mcp — environment variables
# Copy this file to .env and fill in your values. Never commit .env.
#
# Only needed if you're using the standalone CLI (career-mcp-cli) without an
# MCP-capable client. The MCP server itself (career-mcp) needs none of this —
# it relies on the host LLM (Claude Code, Claude Desktop, etc.) to reason.

# ─── Optional — where your resume/stories/applications are stored ────────────
# Defaults to ~/.career-mcp
CAREER_MCP_DATA_DIR=

# ─── Required for the standalone CLI only ─────────────────────────────────────
# Bring your own key — career-mcp never calls a shared/hosted key, so there's
# no cost or liability on anyone but you.
#
# "groq"   — free tier at https://console.groq.com/keys
# "gemini" — free tier at https://aistudio.google.com/apikey
CAREER_MCP_LLM_PROVIDER=groq
CAREER_MCP_API_KEY=
# CAREER_MCP_LLM_MODEL=       # optional override, defaults per provider
